# Copy this file to ".env" and fill in your EmailJS values.
# (.env is git-ignored, so your keys are never committed.)
# Setup guide: src/pages/BookMeeting/EMAILJS_SETUP.md

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Optional – sends a confirmation email to the customer
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=
